# Copy to .env and replace every password/secret before starting Compose.
# Use URL-safe hexadecimal values for database passwords because they appear in URLs.
POSTGRES_DB=social_media_parser
POSTGRES_USER=social_media_parser
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
DATABASE_URL=postgresql://social_media_parser:replace_with_openssl_rand_hex_32@postgres:5432/social_media_parser?schema=public

MONGO_ROOT_USERNAME=social_media_parser
MONGO_ROOT_PASSWORD=replace_with_a_different_openssl_rand_hex_32
MONGO_URI=mongodb://social_media_parser:replace_with_a_different_openssl_rand_hex_32@mongo:27017/social_media_parser?authSource=admin

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace_with_a_unique_initial_password

# Optional exact origins for a separately hosted frontend. Compose's included
# Nginx serves the UI and proxies /api on the same origin, so this can be blank.
FRONTEND_ORIGINS=
TRUST_PROXY_HOPS=1
WEB_PORT=8080
API_PORT=3000
