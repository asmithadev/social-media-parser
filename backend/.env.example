# Copy to .env and replace the PostgreSQL username and both secret values.
DATABASE_URL="postgresql://YOUR_POSTGRES_USER@127.0.0.1:5432/social_media_parser_dev?schema=public"
MONGO_URI="mongodb://127.0.0.1:27017/social_media_parser_dev"
JWT_SECRET="replace-with-a-long-random-secret"
# Replace with an absolute directory on your computer; keep evidence private.
EVIDENCE_DIR="/absolute/path/to/social-media-parser/backend/evidence"
PORT=3000
# Comma-separated exact browser origins allowed to call the API. Keep empty for
# same-origin hosting; set this for the local Vite frontend or a split deployment.
FRONTEND_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
# Set to the number of trusted reverse-proxy hops, usually 1 behind one proxy.
TRUST_PROXY_HOPS=0
# Optional: absolute path if the Tesseract executable is not on PATH.
# TESSERACT_PATH="/opt/homebrew/bin/tesseract"

# Used by `npx prisma db seed` to create the initial local administrator.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="replace-with-a-unique-local-password"
