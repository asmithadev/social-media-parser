{
  "name": "social-media-parser",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "A tool that automatically captures and documents the social media accounts of an accused or suspect during an investigation, so examiners don't have to take and organise screenshots by hand.",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "vercel-build": "npx prisma generate",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:seed:demo": "node prisma/seed-demo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmithadev/social-media-parser.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/asmithadev/social-media-parser/issues"
  },
  "homepage": "https://github.com/asmithadev/social-media-parser#readme",
  "dependencies": {
    "@vercel/blob": "^2.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "3.1.11",
    "prisma": "7.10.1"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@prisma/adapter-pg@7.10.1": true,
    "prisma@7.10.1": true
  }
}
