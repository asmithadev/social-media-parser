# Demo mode uses fictional records and the demo login shown on the page.
# Set to false to sign in with a real account from the Express backend.
VITE_USE_DEMO_DATA=true

# The Vite development server forwards /api to http://127.0.0.1:3000.
# For a separate deployment, use the backend's public URL ending in /api.
VITE_API_BASE_URL=/api
